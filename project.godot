; Godot 4.7.2. Open this directory in the editor.
config_version=5

[application]
config/name="GemTD — Solo Prototype"
config/version="1.0.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A ten-wave solo GemTD game for local review."

[display]
window/size/viewport_width=1360
window/size/viewport_height=900
window/size/window_width_override=1360
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.065, 1)

[audio]
driver/enable_input=false
